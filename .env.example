# =================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo como .env (el cual esta ignorado en Git)
# y complete sus credenciales reales antes de ejecutar docker compose.
# =================================================================

# Credenciales de Base de Datos AWS RDS MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://pedidos-360.cr846626okq7.us-east-1.rds.amazonaws.com:3306/pedidos360
SPRING_DATASOURCE_USERNAME=CONFIGURE_DB_USER
SPRING_DATASOURCE_PASSWORD=CONFIGURE_DB_PASSWORD

# Credenciales y Conexion Unificada de RabbitMQ
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=CONFIGURE_RABBITMQ_USER
SPRING_RABBITMQ_PASSWORD=CONFIGURE_RABBITMQ_PASSWORD

# Opcional: Solo requerido si ejecuta el cluster multi-nodo en rabbitmq-avanzado/docker-compose.yml
RABBITMQ_ERLANG_COOKIE=CONFIGURE_ERLANG_COOKIE

# Microsoft Entra ID (Azure AD)
